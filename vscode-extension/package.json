{
  "name": "tianshu-vscode",
  "displayName": "天枢 Tianshu",
  "description": "天枢 agent 座舱 — DeepSeek 前缀缓存优化的终端编程智能体，VS Code / Cursor 插件端",
  "version": "3.5.6",
  "publisher": "tianshu",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "keywords": [
    "tianshu",
    "ai",
    "coding-agent",
    "deepseek",
    "cursor",
    "agent"
  ],
  "homepage": "https://github.com/huiliyi37/Tianshu-Tui#readme",
  "bugs": {
    "url": "https://github.com/huiliyi37/Tianshu-Tui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huiliyi37/Tianshu-Tui"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onChatParticipant:tianshu.default",
    "onLanguageModelChatProvider:tianshu"
  ],
  "enabledApiProposals": [
    "defaultChatParticipant",
    "chatParticipantAdditions",
    "chatParticipantPrivate"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "tianshu",
          "title": "天枢",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "tianshu.changes",
          "name": "天枢变更"
        }
      ],
      "secondarySidebar": [
        {
          "id": "tianshu.launcher",
          "name": "天枢"
        }
      ]
    },
    "commands": [
      {
        "command": "tianshu.newSession",
        "title": "新建会话",
        "category": "天枢"
      },
      {
        "command": "tianshu.openInEditor",
        "title": "在编辑器中打开座舱",
        "category": "天枢"
      },
      {
        "command": "tianshu.restartSidecar",
        "title": "重启内核 sidecar",
        "category": "天枢"
      },
      {
        "command": "tianshu.showSidecarLog",
        "title": "查看内核日志",
        "category": "天枢"
      },
      {
        "command": "tianshu.refreshChanges",
        "title": "刷新变更",
        "icon": "$(refresh)",
        "category": "天枢"
      },
      {
        "command": "tianshu.rollback",
        "title": "回滚到 checkpoint",
        "icon": "$(discard)",
        "category": "天枢"
      },
      {
        "command": "tianshu.sendSelection",
        "title": "发送到聊天",
        "category": "天枢"
      },
      {
        "command": "tianshu.inlineEdit",
        "title": "行内编辑",
        "category": "天枢"
      },
      {
        "command": "tianshu.acceptEdit",
        "title": "接受委托编辑",
        "category": "天枢"
      },
      {
        "command": "tianshu.rejectEdit",
        "title": "拒绝委托编辑",
        "category": "天枢"
      },
      {
        "command": "tianshu.generateCommitMessage",
        "title": "生成提交语",
        "icon": "$(sparkle)",
        "category": "天枢"
      }
    ],
    "chatParticipants": [
      {
        "id": "tianshu.default",
        "name": "tianshu",
        "fullName": "天枢",
        "description": "与天枢 agent 对话：提问经本地 sidecar 的会话运行时回答。",
        "isSticky": true,
        "isDefault": true,
        "modes": [
          "ask",
          "agent"
        ],
        "locations": [
          "panel"
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "tianshu",
        "displayName": "天枢"
      }
    ],
    "keybindings": [
      {
        "command": "tianshu.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus"
      }
    ],
    "submenus": [
      {
        "id": "tianshu.actions",
        "label": "天枢"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tianshu.sendSelection",
          "group": "tianshu@1"
        },
        {
          "command": "tianshu.inlineEdit",
          "group": "tianshu@2"
        }
      ],
      "editor/title": [
        {
          "submenu": "tianshu.actions",
          "group": "navigation@9"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "tianshu.actions",
          "group": "tianshu@1"
        }
      ],
      "tianshu.actions": [
        {
          "command": "tianshu.sendSelection",
          "group": "tianshu@1"
        },
        {
          "command": "tianshu.inlineEdit",
          "group": "tianshu@2"
        }
      ],
      "view/title": [
        {
          "command": "tianshu.refreshChanges",
          "when": "view == tianshu.changes",
          "group": "navigation@1"
        },
        {
          "command": "tianshu.rollback",
          "when": "view == tianshu.changes",
          "group": "navigation@2"
        }
      ],
      "scm/title": [
        {
          "command": "tianshu.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@1"
        },
        {
          "command": "tianshu.refreshChanges",
          "when": "scmProvider == tianshu",
          "group": "navigation@1"
        },
        {
          "command": "tianshu.rollback",
          "when": "scmProvider == tianshu",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "天枢",
      "properties": {
        "tianshu.cliPath": {
          "type": "string",
          "default": "",
          "description": "rivet CLI 可执行文件路径（留空则自动探测 PATH）"
        },
        "tianshu.serverPort": {
          "type": "number",
          "default": 0,
          "description": "sidecar 端口（0 = 自动选择空闲端口）"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test-timeout=120000 --test \"tests/*.test.ts\"",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.140.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7",
    "undici": "^8.3.0"
  }
}
